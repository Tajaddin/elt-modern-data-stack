# Copy to .env and adjust. Every variable is optional; these are the defaults.

# Station id prefix to keep (GHCN ids start with a two-letter country code). "US" = all US stations.
GHCN_STATION_PREFIX=US
# Days re-read on every run because NOAA revises recent observations.
GHCN_LOOKBACK_DAYS=14
# Earliest date the pipeline loads (backfills start here).
GHCN_START_DATE=2024-01-01
# Where bronze Parquet files, the local DuckDB warehouse and run metrics live.
GHCN_DATA_DIR=data
GHCN_DUCKDB_PATH=data/warehouse.duckdb

# Alerts (Airflow failure callback and Alertmanager). Leave empty to disable.
SLACK_WEBHOOK_URL=

# Airflow (docker compose in ./airflow). Generate real values; never commit them.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   -> AIRFLOW_FERNET_KEY
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                               -> AIRFLOW_JWT_SECRET
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
# With the observability profile up: StatsD metrics on, and the extractor's OpenTelemetry traces to the collector.
AIRFLOW_STATSD_ON=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# e.g. OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Airflow's own tracer; leave off (see airflow/docker-compose.yml for why).
AIRFLOW_OTEL_ON=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# dbt target used by the Airflow DAG: duckdb | databricks | snowflake
DBT_TARGET=duckdb
DBT_SEND_ANONYMOUS_USAGE_STATS=false

# Hosted warehouses (dbt targets). Never commit real values.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=GHCN
